<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOcrHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="OCR Label &amp; Ingredient Text Recognition"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layoutOcrActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvOcrHeader">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickGallery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gallery"
                app:icon="@android:drawable/ic_menu_gallery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Camera"
                app:icon="@android:drawable/ic_menu_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryOcr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Reset"
                app:icon="@android:drawable/ic_menu_revert" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgOcrPreview"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutOcrActions"
            tools:src="@tools:sample/avatars" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAllergens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/imgOcrPreview">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFEBEE"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Potential Allergens Detected:"
                    android:textColor="#C62828"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetectedAllergens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#B71C1C"
                    tools:text="Milk, Wheat, Peanuts" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Editable Extracted Ingredients Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExtractedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/cardAllergens">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extracted Ingredients (Editable)"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etExtractedIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="Scan a label or type ingredients text manually..."
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action 1: Predict NOVA with AI Model (Member 2) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPredictNovaAi"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🤖 Predict NOVA Group (Member 2 AI Model)"
            app:layout_constraintTop_toBottomOf="@id/cardExtractedText" />

        <!-- AI Prediction Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiPredictionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:layout_constraintTop_toBottomOf="@id/btnPredictNovaAi">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F3E5F5"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvAiPredictionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#4A148C"
                    android:textSize="13sp"
                    tools:text="AI Model Prediction Offline" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action 2: Search Open Food Facts -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchExtractedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔍 Search Open Food Facts Database"
            app:layout_constraintTop_toBottomOf="@id/cardAiPredictionResult" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
