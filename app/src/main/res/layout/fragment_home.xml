<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Welcome / Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1B5E20"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥗 Food Facts"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Food Processing &amp; Nutritional Intelligence"
                    android:textColor="#E8F5E9"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quick Actions"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1. Scan Barcode -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavScan"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="📷   Scan Product Barcode"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <!-- 2. Search Product -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavSearch"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="🔍   Search Products by Name"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <!-- 3. Scan Ingredients (OCR) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavOcr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="📝   Scan &amp; Extract Ingredients (OCR)"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <!-- 4. Compare Products -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavCompare"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="⚖️   Compare Two Products"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <!-- 5. Scan History -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavHistory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="📜   Scan History &amp; Event Logs"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <!-- Project Integration Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Team Integration Architecture"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• Member 1 (Big Data): GTIN-14 scan events logged locally to Room for Spark streaming ingestion."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• Member 2 (Deep Learning): Configurable REST endpoint for ingredient text NOVA classification."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• Member 3 (Mobile App): Native Kotlin &amp; XML Views Android application."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
