<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.foodfacts.ui.fragments.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.foodfacts.ui.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.foodfacts.ui.fragments.HomeFragment"
        android:label="Food Facts Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_scanFragment"
            app:destination="@id/scanFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_ocrFragment"
            app:destination="@id/ocrFragment" />
        <action
            android:id="@+id/action_homeFragment_to_compareFragment"
            app:destination="@id/compareFragment" />
        <action
            android:id="@+id/action_homeFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanFragment"
        android:name="com.example.foodfacts.ui.fragments.ScanFragment"
        android:label="Scan Barcode"
        tools:layout="@layout/fragment_scan">
        <action
            android:id="@+id/action_scanFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_scanFragment_to_ocrFragment"
            app:destination="@id/ocrFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.foodfacts.ui.fragments.SearchFragment"
        android:label="Search Products"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.foodfacts.ui.fragments.HistoryFragment"
        android:label="Scan &amp; View History"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_historyFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/compareFragment"
        android:name="com.example.foodfacts.ui.fragments.CompareFragment"
        android:label="Product Comparison"
        tools:layout="@layout/fragment_compare" />

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.foodfacts.ui.fragments.ProductDetailFragment"
        android:label="Product Details"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="barcode"
            app:argType="string" />
        <action
            android:id="@+id/action_productDetailFragment_to_compareFragment"
            app:destination="@id/compareFragment" />
    </fragment>

    <fragment
        android:id="@+id/ocrFragment"
        android:name="com.example.foodfacts.ui.fragments.OcrFragment"
        android:label="OCR Text Recognition"
        tools:layout="@layout/fragment_ocr">
        <action
            android:id="@+id/action_ocrFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>

</navigation>
